---
import { meta } from '../data/meta.js'
---

<footer class="footer">
  <div class="container inner">
    <p class="links">
      <a href={meta.licenseUrl} rel="noopener noreferrer" target="_blank">Licenza MIT</a>
      <span aria-hidden="true">·</span>
      <a href={meta.contributingUrl} rel="noopener noreferrer" target="_blank">Contribuire</a>
      <span aria-hidden="true">·</span>
      <a href={meta.securityUrl} rel="noopener noreferrer" target="_blank">Sicurezza</a>
      <span aria-hidden="true">·</span>
      <a href={meta.releasesUrl} rel="noopener noreferrer" target="_blank">Novità</a>
      <span aria-hidden="true">·</span>
      <a href={meta.issuesUrl} rel="noopener noreferrer" target="_blank">Segnala un problema</a>
    </p>
    <p class="meta">
      Bacco v{meta.version} · fatto da
      <a href={meta.authorUrl} rel="noopener noreferrer" target="_blank">{meta.authorHandle}</a>
      · Bevi responsabilmente.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--linea);
    padding: 2.5rem 0 3rem;
    color: var(--cenere);
    font-size: 0.95rem;
  }
  .inner {
    display: grid;
    gap: 0.75rem;
    text-align: center;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .links a {
    color: var(--gesso);
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
</style>
