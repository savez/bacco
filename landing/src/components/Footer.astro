---
// Piede comune alle landing di @savez: stesse tre colonne, stessa firma
// dell'autore e la stessa lista dei progetti, ognuna nel proprio stile.
import { meta, projects } from '../data/meta.js'

const base = import.meta.env.BASE_URL
const others = projects.filter((p) => p.id !== 'bacco')
const ext = { rel: 'noopener noreferrer', target: '_blank' }
---

<footer class="footer">
  <div class="container">
    <div class="grid">
      <div class="about">
        <a href="#top" class="brand">
          <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
          <span>{meta.appName}</span>
        </a>
        <p>Bottiglie, foto e note restano nel browser del telefono. Nessun account, nessun server, nessun tracciamento.</p>
      </div>
      <nav aria-labelledby="footer-progetto">
        <h2 id="footer-progetto">Progetto</h2>
        <ul>
          <li><a href={meta.githubUrl} {...ext}>Codice sorgente</a></li>
          <li><a href={meta.releasesUrl} {...ext}>Novità</a></li>
          <li><a href={meta.contributingUrl} {...ext}>Contribuire</a></li>
          <li><a href={meta.issuesUrl} {...ext}>Segnala un problema</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="footer-sostieni">
        <h2 id="footer-sostieni">Sostieni</h2>
        <ul>
          <li><a href={meta.supportUrl} {...ext}>Offrimi una birra o un vino</a></li>
          <li><a href={meta.starsUrl} {...ext}>Metti una stella</a></li>
          <li><a href={meta.securityUrl} {...ext}>Segnala una vulnerabilità</a></li>
          <li><a href={meta.licenseUrl} {...ext}>Licenza MIT</a></li>
        </ul>
      </nav>
    </div>

    <div class="signature">
      <a class="author" href={meta.authorUrl} {...ext}>
        <img src={`${base}progetti/savez.jpg`} alt="" width="48" height="48" loading="lazy" />
        <span>
          <strong>{meta.authorHandle}</strong>
          <span>Autore e contributor principale</span>
        </span>
      </a>
      <div class="others">
        <p>Altri progetti di {meta.authorHandle}</p>
        <ul>
          {others.map((p) => (
            <li>
              <a href={p.url} {...ext}>
                <img src={`${base}${p.icon}`} alt="" width="28" height="28" loading="lazy" />
                <span><strong>{p.name}</strong><span>{p.what}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="legal">
      <span>{meta.appName} v{meta.version}. Bevi responsabilmente.</span>
      <span>Fatto da <a href={meta.authorUrl} {...ext}>{meta.authorHandle}</a>, rilasciato con licenza MIT</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--linea);
    padding: 3rem 0 2.5rem;
    color: var(--cenere);
    font-size: 0.95rem;
  }
  .grid {
    display: grid;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--gesso);
    font-family: var(--font-display);
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }
  .brand img {
    border-radius: 7px;
  }
  .brand:hover {
    text-decoration: none;
  }
  .about p {
    max-width: 38ch;
  }
  .footer h2 {
    font-family: var(--font-sans);
    text-transform: none;
    letter-spacing: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--rame);
    margin-bottom: 0.5rem;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .grid nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--gesso);
  }
  .signature {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--linea);
  }
  .author {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--gesso);
    align-self: start;
  }
  .author:hover {
    text-decoration: none;
  }
  .author img {
    border-radius: 999px;
    border: 2px solid var(--rame);
  }
  .author > span,
  .others a > span {
    display: grid;
    line-height: 1.35;
  }
  .author > span > span,
  .others a > span > span {
    color: var(--cenere);
    font-size: 0.9rem;
  }
  .others > p {
    color: var(--gesso);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .others ul {
    gap: 0.5rem;
  }
  .others a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    background: var(--doga);
    border: 1px solid var(--linea);
    color: var(--gesso);
  }
  .others a:hover {
    text-decoration: none;
    border-color: var(--rame);
  }
  .others img {
    border-radius: 6px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    margin-top: 2rem;
    font-size: 0.88rem;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
    .signature {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
    .others ul {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
