---
// Stessa testata delle altre landing di @savez: marchio a sinistra, poi le
// sezioni della pagina (solo da tablet in su), GitHub e una sola azione piena.
import { meta } from '../data/meta.js'
const base = import.meta.env.BASE_URL

const sections = [
  { href: '#funzioni', label: 'Funzioni' },
  { href: '#punteggio', label: 'Punteggio' },
  { href: '#installa', label: 'Installa' },
]
---

<nav class="nav" aria-label="Principale">
  <div class="container nav-inner">
    <a href="#top" class="brand">
      <img src={`${base}favicon.svg`} alt="" width="32" height="32" />
      <span>{meta.appName}</span>
    </a>
    <div class="links">
      {sections.map((s) => <a class="section-link" href={s.href}>{s.label}</a>)}
      <a href={meta.githubUrl} rel="noopener noreferrer" target="_blank" aria-label="Codice su GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="section-link">GitHub</span>
      </a>
      <a class="open" href={meta.appUrl} rel="noopener noreferrer" target="_blank">Apri l'app</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(28, 22, 19, 0.82);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--linea);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--gesso);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .brand img {
    border-radius: 8px;
  }
  .brand:hover {
    text-decoration: none;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0 0.6rem;
    color: var(--cenere);
  }
  .links a:hover {
    color: var(--gesso);
  }
  .links .section-link {
    display: none;
  }
  .links .open {
    margin-left: 0.5rem;
    color: var(--botte);
    background: var(--feccia);
    border-radius: 999px;
    padding: 0 1rem;
  }
  .links .open:hover {
    color: var(--botte);
    text-decoration: none;
  }
  @media (min-width: 720px) {
    .links .section-link {
      display: inline-flex;
    }
  }
</style>
