---
import { meta } from '../data/meta.js'
const stack = ['Vue 3', 'Tailwind CSS 4', 'Dexie / IndexedDB', 'Workbox', 'Leaflet', 'Vitest', 'Docker']
---

<section class="section" id="open-source">
  <div class="container">
    <span class="eyebrow">Open source</span>
    <h2 class="section-title">Leggilo, forkalo, miglioralo.</h2>
    <p class="section-sub">
      Licenza MIT. Il codice è su GitHub: le PR sono benvenute, le idee anche.{' '}
      <a href={meta.contributingUrl} rel="noopener noreferrer" target="_blank">Come contribuire</a>.
    </p>
    <p class="author">
      <img src={`${import.meta.env.BASE_URL}progetti/savez.jpg`} alt="" width="44" height="44" loading="lazy" />
      <span>
        Scritto e mantenuto da{" "}
        <a href={meta.authorUrl} rel="noopener noreferrer" target="_blank">{meta.authorHandle}</a>,
        autore e contributor principale.
      </span>
    </p>
    <ul class="stack">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.5rem;
    color: var(--cenere);
    max-width: 58ch;
  }
  .author img {
    flex: 0 0 auto;
    border-radius: 999px;
    border: 2px solid var(--rame);
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stack li {
    border: 1px solid var(--linea);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-weight: 700;
    font-size: 0.95rem;
  }
</style>
